{
  "name": "@denwilliams/recipes-cli",
  "version": "0.1.0",
  "description": "Discover and retrieve attributed recipes through configurable providers",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/denwilliams/recipes-cli.git" },
  "engines": { "node": ">=22" },
  "bin": { "recipes": "dist/src/bin.js" },
  "files": ["dist/src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/test/*.test.js",
    "smoke:live": "npm run build && node scripts/live-smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": { "cheerio": "1.1.2", "ipaddr.js": "2.3.0" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.9.3" }
}
